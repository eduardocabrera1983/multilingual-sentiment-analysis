# Development Environment Configuration
# This is a sample .env file for development use
# Copy this to .env and customize with your actual values

# ==============================================
# APPLICATION SETTINGS
# ==============================================

# Flask Secret Key - GENERATE A NEW ONE FOR PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-this-for-production

# Flask Environment
FLASK_DEBUG=true

# Server Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ==============================================
# ML MODEL CONFIGURATION
# ==============================================

# Force specific device usage (true/false)
FORCE_CPU=false
FORCE_GPU=false

# Hugging Face Model IDs (default values - can be customized)
SENTIMENT_MODEL_1=cardiffnlp/twitter-xlm-roberta-base-sentiment-multilingual
SENTIMENT_MODEL_2=cardiffnlp/twitter-roberta-base-sentiment-latest
ASPECT_MODEL=facebook/bart-large-mnli

# Model weights for ensemble (0.0 to 1.0)
SENTIMENT_MODEL_1_WEIGHT=0.6
SENTIMENT_MODEL_2_WEIGHT=0.4

# ==============================================
# HUGGING FACE CONFIGURATION (OPTIONAL)
# ==============================================

# Hugging Face API Token (get from https://huggingface.co/settings/tokens)
# Uncomment and add your token if needed:
# HF_TOKEN=hf_your_token_here

# ==============================================
# DATA SCRAPING CONFIGURATION
# ==============================================

# FedEx App ID for Google Play Store scraping
FEDEX_APP_ID=com.fedex.ida.android

# Default scraping parameters
DEFAULT_REVIEW_COUNT=500
SCRAPING_LANGUAGE=en
SCRAPING_COUNTRY=US

# ==============================================
# FILE UPLOAD SETTINGS
# ==============================================

# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=16

# ==============================================
# DIRECTORIES
# ==============================================

# Cache directory
CACHE_DIR=cache

# Data directory
DATA_DIR=data

# Upload directory
UPLOAD_DIR=uploads

# ==============================================
# LOGGING
# ==============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# ==============================================
# SECURITY SETTINGS
# ==============================================

# CORS origins (comma-separated domains, or * for all)
CORS_ORIGINS=*

# Session cookie settings (for development)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true