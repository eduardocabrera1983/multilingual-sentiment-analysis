# Multilingual Sentiment Analysis - Environment Configuration Template
# Copy this file to .env and update with your actual values
# NEVER commit the .env file to version control!

# ==============================================
# APPLICATION SETTINGS
# ==============================================

# Flask Secret Key - Generate a strong random key for production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-generate-a-strong-one

# Flask Environment (development/production)
FLASK_ENV=development

# Flask Debug Mode (true/false)
FLASK_DEBUG=true

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ==============================================
# ML MODEL CONFIGURATION
# ==============================================

# Force specific device usage (true/false)
FORCE_CPU=false
FORCE_GPU=false

# Hugging Face Model IDs (can be customized)
SENTIMENT_MODEL_1=cardiffnlp/twitter-xlm-roberta-base-sentiment-multilingual
SENTIMENT_MODEL_2=cardiffnlp/twitter-roberta-base-sentiment-latest
ASPECT_MODEL=facebook/bart-large-mnli

# Model weights for ensemble (0.0 to 1.0)
SENTIMENT_MODEL_1_WEIGHT=0.6
SENTIMENT_MODEL_2_WEIGHT=0.4

# ==============================================
# HUGGING FACE CONFIGURATION
# ==============================================

# Hugging Face API Token (optional, for private models or increased rate limits)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here

# Hugging Face Cache Directory (optional)
HF_HOME=.cache/huggingface

# ==============================================
# DATA SCRAPING CONFIGURATION
# ==============================================

# FedEx App ID for Google Play Store scraping
FEDEX_APP_ID=com.fedex.ida.android

# Default scraping parameters
DEFAULT_REVIEW_COUNT=500
SCRAPING_LANGUAGE=en
SCRAPING_COUNTRY=US

# ==============================================
# FILE UPLOAD SETTINGS
# ==============================================

# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=16

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=csv,xlsx,xls,tsv

# ==============================================
# CACHE AND PERFORMANCE
# ==============================================

# Cache directory
CACHE_DIR=cache

# Data directory
DATA_DIR=data

# Upload directory
UPLOAD_DIR=uploads

# Enable model caching (true/false)
ENABLE_MODEL_CACHE=true

# ==============================================
# LOGGING AND MONITORING
# ==============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable performance monitoring (true/false)
ENABLE_MONITORING=true

# ==============================================
# DATABASE CONFIGURATION (if needed in future)
# ==============================================

# Currently not used, but reserved for future database integration
# DATABASE_URL=sqlite:///app.db
# DATABASE_POOL_SIZE=5
# DATABASE_TIMEOUT=30

# ==============================================
# SECURITY SETTINGS
# ==============================================

# CORS origins (comma-separated domains, or * for all)
CORS_ORIGINS=*

# Enable HTTPS redirect in production (true/false)
FORCE_HTTPS=false

# Session cookie settings
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# ==============================================
# PRODUCTION DEPLOYMENT
# ==============================================

# Gunicorn workers (for production deployment)
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# Docker configuration
DOCKER_PORT=5000

# ==============================================
# API RATE LIMITING (if needed)
# ==============================================

# Rate limiting settings
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000